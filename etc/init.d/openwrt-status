#!/bin/sh /etc/rc.common
# OpenWrt procd init script for openwrt-status service

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/openwrt-status
CONF=/etc/config/openwrt-status

start_service() {
    # 默认配置参数
    local port="9090"
    local host="0.0.0.0"
    local interval="1s"
    local token=""
    local enabled="1"

    # 如果存在 UCI 配置文件则优先读取
    if [ -f "$CONF" ]; then
        config_load "openwrt-status"
        config_get enabled "config" "enabled" "1"
        config_get port "config" "port" "9090"
        config_get host "config" "host" "0.0.0.0"
        config_get interval "config" "interval" "1s"
        config_get token "config" "token" ""
    fi

    [ "$enabled" = "0" ] && return 0

    [ -x "$PROG" ] || {
        echo "Error: $PROG executable not found!" >&2
        return 1
    }

    procd_open_instance
    procd_set_param command "$PROG" -host "$host" -port "$port" -interval "$interval" -token "$token"
    # 崩溃自动重启守护: 重启尝试间隔 5 秒，超过 10 次报错
    procd_set_param respawn 3600 5 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # procd 自动根据进程 PID 树处理停止
    return 0
}
